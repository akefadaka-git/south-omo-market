APP_ENV=development
APP_NAME=South Omo Market API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://south_omo:local_only_password@localhost:5432/south_omo_market
DATABASE_URL_UNPOOLED=postgresql+psycopg://south_omo:local_only_password@localhost:5432/south_omo_market
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ISSUER=south-omo-market
ACCESS_TOKEN_MINUTES=30

# Production release gates: leave false until evidence is approved.
DATA_RESIDENCY_COUNTRY=unknown
DATA_RESIDENCY_CONFIRMED=false
DATA_RESIDENCY_EVIDENCE_REF=
PRODUCTION_LEGAL_REVIEW_CONFIRMED=false
PRIVACY_NOTICE_URL=
DATA_PROTECTION_IMPACT_ASSESSMENT_COMPLETED=false
PROCESSING_RECORDS_COMPLETED=false
DATA_PROTECTION_OFFICER_APPLICABILITY_ASSESSED=false
DATA_PROTECTION_OFFICER_REQUIRED=false
DATA_PROTECTION_OFFICER_CONTACT=
SELLER_PHONE_VERIFICATION_READY=false
